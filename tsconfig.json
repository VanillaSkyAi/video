{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@vanillaskyai/video/server": ["src/server.ts"],
      "@vanillaskyai/video/templates": ["src/templates.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "tests", "scripts", "examples/custom-template", "playwright.config.ts", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["tests/fixtures/nextjs-provider-app"]
}
