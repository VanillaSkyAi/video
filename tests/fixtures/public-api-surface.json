      "SceneTemplateMetadata",
      "SceneTemplateProps",
      "TemplateTransitionTiming",
      "TemplateDefinition",
      "TemplateExample",
      "TemplateFamily",
      "TemplateJsonSchema",
      "TemplateRegistry",
